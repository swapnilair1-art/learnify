# Copy to .env.local and adjust values for local development

# Postgres (Docker Compose)
DATABASE_URL=postgresql://learnify:learnify@localhost:5432/learnify_dev?schema=public

# Clerk (optional in local dev)
NEXT_PUBLIC_CLERK_FRONTEND_API=
CLERK_SECRET_KEY=

# Demo user id for local dev fallback (used where auth not wired)
NEXT_PUBLIC_DEMO_USER_ID=demo

# OpenAI (optional)
OPENAI_API_KEY=
